{
  "manifest_version": 3,
  "name": "HKU Piano Companion",
  "version": "1.0.0",
  "description": "Local HKUFBS login, booking preparation, timed submission, and manual CAPTCHA reminders. Unofficial; no challenge solving.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://hkufbs.hku.hk/*",
    "https://www.google.com/recaptcha/*",
    "https://www.recaptcha.net/recaptcha/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open HKU Piano Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hkufbs.hku.hk/fbs/centralbook/book/Web/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/recaptcha/*",
        "https://www.recaptcha.net/recaptcha/*"
      ],
      "js": [
        "captcha-frame.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "minimum_chrome_version": "120"
}
